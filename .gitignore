# --- Datos (pesados o regenerables con los scripts) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Logs de ejecución ---
logs/*
!logs/.gitkeep

# --- Credenciales y configuración local ---
.env
*.key
credentials*.json

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- Quarto (archivos generados al renderizar) ---
reports/*_files/
reports/*.html
reports/*.docx
reports/*.pdf
.quarto/

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
.vscode/
.positron/
